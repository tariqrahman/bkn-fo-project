# Supabase Postgres — Dashboard → Connect → Connection pooling
#
# Local migrate/ingest: Session mode, port 5432 (IPv4-compatible pooler)
#   postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Deployed API: Transaction mode, port 6543 + ?pgbouncer=true
#   postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Avoid db.[project-ref].supabase.co on most home networks (IPv6-only → ENOTFOUND).
DATABASE_URL=

# API server port (optional — Railway sets PORT automatically)
PORT=3001

# Production: set to your Vercel/web URL (e.g. https://nets-front-office.vercel.app)
# CORS_ORIGIN=

# AI insights — required for /api/teams/:id/insights generation
ANTHROPIC_API_KEY=

# Optional: override insights model (default: claude-sonnet-4-5-20250929)
# INSIGHTS_MODEL=claude-sonnet-4-5-20250929
