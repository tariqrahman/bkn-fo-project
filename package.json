{
  "name": "nets-front-office",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @nets/api & npm run dev --workspace @nets/web",
    "dev:api": "npm run dev --workspace @nets/api",
    "dev:web": "npm run dev --workspace @nets/web",
    "db:generate": "npm run generate --workspace @nets/db",
    "db:migrate": "npm run migrate --workspace @nets/db",
    "db:ingest": "npm run ingest --workspace @nets/db",
    "db:ingest:cap": "npm run ingest:cap --workspace @nets/db",
    "db:ingest:depth": "npm run ingest:depth --workspace @nets/db",
    "db:ingest:draft": "npm run ingest:draft --workspace @nets/db",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @nets/web",
    "start:api": "npm run start --workspace @nets/api"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
